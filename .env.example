# Plantilla: copiar a .env y llenarlo. instalar.sh copia el .env a /opt/respaldo-postgres/.env (chmod 600).

# Nombre del contenedor de Postgres en el servidor.  ->  docker ps --format '{{.Names}}'
CONTAINER=

# Base de datos a respaldar.  ->  docker exec <contenedor> psql -U <usuario> -l
DB_NAME=

# Usuario de Postgres dentro del contenedor (normalmente el POSTGRES_USER del docker-compose).
DB_USER=postgres

# Contraseña: déjala vacía con la imagen oficial de Postgres (no la pide por socket local).
DB_PASSWORD=

# Carpeta del servidor donde quedan los dumps (fuera del proyecto de la app).
LOCAL_DIR=/var/backups/postgres

# <remoto de rclone>:<carpeta en Drive>. "gdrive" es el nombre que le des en `rclone config`.
RCLONE_REMOTE=gdrive:Respaldos/

# Archivo de config de rclone. Vacío = /root/.config/rclone/rclone.conf (el cron corre como root).
RCLONE_CONFIG_FILE=

# Cuántos respaldos conservar (en el servidor y en Drive).
KEEP_LAST=7

# Compresión de pg_dump (0-9). 6 es un buen equilibrio.
COMPRESS=6

# Log de las ejecuciones.
LOG_FILE=/var/log/respaldo-postgres.log
